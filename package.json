{
  "name": "zod-ph",
  "version": "0.1.2",
  "description": "Philippine‑ready Zod validators, formatters, and utilities for TypeScript apps",
  "license": "MIT",
  "author": "rodrigoricky",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodrigoricky/zod-ph"
  },
  "keywords": [
    "zod",
    "philippines",
    "validation",
    "mobile-number",
    "zip-code",
    "peso",
    "address",
    "psgc",
    "typescript",
    "form-validation"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./validators": {
      "types": "./dist/validators/index.d.ts",
      "import": "./dist/validators/index.mjs",
      "require": "./dist/validators/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.mjs",
      "require": "./dist/format/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "zod": "^3.22.0"
  },
  "dependencies": {},
  "devDependencies": {
    "vitest": "^1.6.0",
    "typescript": "^5.5.0",
    "tsup": "^8.2.0",
    "eslint": "^9.0.0",
    "@types/node": "^20.14.0",
    "zod": "^3.23.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  }
}
